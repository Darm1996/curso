# Supabase
# Proyecto donde vive la tabla `leads`. Ver supabase/migrations/0001_leads.sql
#
# Estas dos variables son de servidor. No llevan el prefijo NEXT_PUBLIC_ a
# propósito: la clave no se envía al navegador, el formulario escribe a través
# de /api/leads.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-clave-anonima

# Opcional. Si la defines, se usa como metadataBase para que las tarjetas de
# redes sociales resuelvan rutas absolutas.
NEXT_PUBLIC_SITIO_URL=https://curso.contave.com
